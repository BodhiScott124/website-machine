# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# original full-size photos (in per-country subfolders) are kept on disk /
# OneDrive, not in git. only the web-optimised copies under photos/web and
# photos/thumb are committed.
/public/photos/**
!/public/photos/web/
!/public/photos/web/**
!/public/photos/thumb/
!/public/photos/thumb/**

# typescript
*.tsbuildinfo
next-env.d.ts
